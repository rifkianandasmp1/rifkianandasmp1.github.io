                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Negative test. Answered after a deliberate ~800 ms delay.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"definitely-not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Body has an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));",
                  "pm.test(\"No cookie is set\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in - missing Origin (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Negative test. State-changing requests without an Origin header are rejected (CSRF protection).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Body has an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Signs in with `admin_password` from the environment and stores the `admin_session` cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "const match = setCookie.match(/admin_session=([^;]+)/);",
                  "pm.test(\"Sets an HttpOnly, Secure, SameSite=Strict session cookie\", () => {",
                  "  pm.expect(match, \"admin_session cookie\").to.not.be.null;",
                  "  pm.expect(setCookie).to.include(\"HttpOnly\");",
                  "  pm.expect(setCookie).to.include(\"Secure\");",
                  "  pm.expect(setCookie).to.include(\"SameSite=Strict\");",
                  "});",
                  "if (match) pm.collectionVariables.set(\"session_cookie\", match[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Session status (signed in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Should now report authenticated: true."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"authenticated is true\", () => pm.expect(pm.response.json().authenticated).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
