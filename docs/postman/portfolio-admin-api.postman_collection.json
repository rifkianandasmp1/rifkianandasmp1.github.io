    {
      "name": "2. Auth",
      "description": "Sign in with the admin password. A successful sign-in saves the session cookie in the collection variable `session_cookie`; the collection pre-request script sends it on every request.",
      "item": [
        {
          "name": "Session status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Never fails; returns whether the request carries a valid session."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"authenticated is a boolean\", () => pm.expect(pm.response.json().authenticated).to.be.a(\"boolean\"));"
                ]
              }
            }
          ]
        },
        {
