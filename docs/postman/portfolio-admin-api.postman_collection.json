    {
      "name": "3. Content (read + safe checks)",
      "description": "Reads the content document from GitHub and runs validation checks that never commit.",
      "item": [
        {
          "name": "Get content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "content"
              ]
            },
            "description": "Reads public/data/portfolio.json from GitHub (latest commit, not the deployed copy). Saves `content_sha` and `content_data` for the publish requests."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Has data and sha\", () => {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body).to.have.property(\"sha\");",
                  "});",
                  "if (body.data) {",
                  "  pm.collectionVariables.set(\"content_data\", JSON.stringify(body.data));",
                  "  pm.collectionVariables.set(\"content_sha\", body.sha);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish - stale baseSha (409, no commit)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "content"
              ]
            },
            "description": "Negative test of optimistic concurrency: a baseSha that differs from the file on GitHub is rejected with 409 and `conflict: true`. Nothing is committed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{content_data}},\n  \"baseSha\": \"0000000000000000000000000000000000000000\",\n  \"message\": \"Should not be committed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Reports a conflict with the latest sha\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.conflict).to.eql(true);",
                  "  pm.expect(body.latestSha).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish - invalid data (400, no commit)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "content"
              ]
            },
            "description": "Negative test: `profile` must be an object and list sections must be arrays.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": { \"profile\": {}, \"projects\": \"not a list\" },\n  \"message\": \"Should not be committed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Body has an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload - not an image (415, no commit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            },
            "description": "Negative test: only JPEG, PNG or WebP bytes are accepted (detected from the content, not the filename).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"fake.jpg\",\n  \"content\": \"PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 415\", () => pm.response.to.have.status(415));",
                  "pm.test(\"Body has an error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Writes (commit to GitHub!)",
      "description": "⚠️ These requests create real commits on the environment's branch, and each commit triggers a Vercel deployment. Prefer the Preview or Local environment, or untick this folder in the Collection Runner.",
      "item": [
        {
          "name": "⚠️ Publish content",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "content"
              ]
            },
            "description": "Re-publishes the document read by 'Get content' (only meta.updated changes) and stores the new sha.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {{content_data}},\n  \"baseSha\": \"{{content_sha}}\",\n  \"message\": \"Publish from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the new sha and commit URL\", () => {",
                  "  pm.expect(body.sha).to.be.a(\"string\");",
                  "  pm.expect(body.data.meta.updated).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});",
                  "pm.collectionVariables.set(\"content_sha\", body.sha);",
                  "pm.collectionVariables.set(\"content_data\", JSON.stringify(body.data));"
                ]
              }
            }
          ]
        },
        {
          "name": "⚠️ Upload image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}",
                "description": "Required for POST/PUT/DELETE (CSRF check). Must match the host."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            },
            "description": "Commits a 1×1 PNG to public/images/. The returned path can be used as profile.photo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"postman-test.png\",\n  \"content\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a site-relative image path\", () =>",
                  "  pm.expect(pm.response.json().path).to.match(/^images\\/postman-test-[a-z0-9]+\\.png$/));"
                ]
              }
            }
          ]
        }
      ]
    },
